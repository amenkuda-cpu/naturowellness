# ─────────────────────────────────────────────────────────────────────────
# Naturo Wellness: environment configuration (PLACEHOLDER VALUES ONLY)
# Copy to .env.local for development. Set real values in your host's
# environment settings for production. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# Public site URL (used for SEO, payment return URLs and magic links)
NEXT_PUBLIC_SITE_URL=https://www.example.co.zw

# ── Supabase (database + auth) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments ─────────────────────────────────────────────────────────────
PAYMENT_COD_ENABLED=false
PAYMENT_MANUAL_ENABLED=false
# Shown to customers who choose manual payment (e.g. merchant code / bank details).
PAYMENT_MANUAL_INSTRUCTIONS="Pay via ... using your order number as the reference."

# Paynow Zimbabwe (https://www.paynow.co.zw). Requires merchant approval.
PAYMENT_PAYNOW_ENABLED=false
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_MERCHANT_EMAIL=

# ── Store settings ───────────────────────────────────────────────────────
# Tax in basis points (1500 = 15%). Leave 0 until confirmed with your accountant.
NEXT_PUBLIC_TAX_RATE_BPS=0
NEXT_PUBLIC_COLLECTION_ENABLED=true
NEXT_PUBLIC_COLLECTION_DETAILS=
# Optional promotional banner shown above the header.
NEXT_PUBLIC_ANNOUNCEMENT=

# ── Contact details (leave blank until verified) ─────────────────────────
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# ── Analytics: none | gtm | plausible | console ──────────────────────────
NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# ── Development only (ignored when NODE_ENV=production) ──────────────────
# Clearly labelled SAMPLE prices so the cart & checkout can be exercised.
NATURO_DEV_SAMPLE_PRICES=false
# Unauthenticated /admin access when Supabase is not configured.
NATURO_DEV_ADMIN=false
# Set to "false" to disable the local JSON order store (.naturo-dev/store.json).
NATURO_DEV_STORE=true
